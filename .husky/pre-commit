#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Run lint-staged on staged files (don't run commitlint here — it's handled by commit-msg)
npx --no-install eslint src --ext .ts,.tsx,.js,.jsx --max-warnings=0

# If the full-check passes, run lint-staged to fix/format staged files
npx --no-install lint-staged
